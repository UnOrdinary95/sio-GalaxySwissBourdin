{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@gsb/backend",
    "private": true,
    "type": "module",
    "version": "1.0.0",
    "description": "",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "eslint \"src/**/*.{ts,js}\"",
        "lint:fix": "eslint \"src/**/*.{ts,js}\" --fix",
        "format": "prettier --write \"src/**/*.{ts,js,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,js,json}\""
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.28.0",
    "dependencies": {
        "@gsb/types": "workspace:*",
        "@gsb/utils": "workspace:*",
        "bcrypt": "^5.1.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^5.1.0",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "swagger-ui-express": "^5.0.1",
        "yamljs": "^0.3.0",
        "morgan": "^1.10.0",
        "zod": "^3.24.2",
        "pg": "^8.13.3"
    },
    "devDependencies": {
        "ts-node": "^10.9.2",
        "typescript": "^5.8.2",
        "tsx": "^4.19.3",
        "@types/morgan": "^1.9.10",
        "@types/express": "^5.0.0",
        "@types/bcrypt": "^5.0.2",
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/node": "^22.13.5",
        "@types/pg": "^8.11.11",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/yamljs": "^0.2.34"
    }
}
